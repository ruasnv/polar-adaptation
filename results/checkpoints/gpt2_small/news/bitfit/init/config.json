{
  "training": {
    "optimizer": "adamw",
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "micro_batch_size": 1,
    "gradient_accumulation_steps": 32,
    "max_seq_len": 512,
    "epochs": 5,
    "warmup_ratio": 0.06,
    "lr_schedule": "linear_decay",
    "gradient_clip": 1.0,
    "gradient_checkpointing": true,
    "eval_every_n_steps": 500,
    "save_every_epoch": true,
    "seed": 42
  },
  "logging": {
    "log_every_n_steps": 10,
    "rotation_drift_every_n_steps": 100,
    "eigenvalue_variance_every_n_steps": 100,
    "effective_rank_every_n_steps": 100,
    "geometric_health_every_epoch": true
  },
  "geometric_health": {
    "stable_rank": true,
    "sv_entropy": true,
    "effective_rank": true,
    "condition_number": true,
    "nuclear_norm": true,
    "isotropy": true,
    "target_matrices": [
      "W_V",
      "W_O"
    ],
    "include_W_Q_W_K": false,
    "per_head": true,
    "aggregate_across_layers": true
  },
  "model": {
    "name": "gpt2",
    "hf_name": "gpt2",
    "params": "117M",
    "n_layers": 12,
    "n_heads": 12,
    "d_model": 768,
    "d_head": 64,
    "vocab_size": 50257
  },
  "domain": {
    "name": "news",
    "shift": "small",
    "tasks": {
      "summarization": {
        "dataset": "cnn_dailymail",
        "dataset_version": "3.0.0",
        "split_train": "train",
        "split_val": "validation",
        "split_test": "test",
        "metrics": [
          "rouge1",
          "rouge2",
          "rougeL"
        ],
        "type": "generative",
        "input_col": "article",
        "target_col": "highlights"
      },
      "sentiment": {
        "dataset": "sst2",
        "split_train": "train",
        "split_val": "validation",
        "split_test": "validation",
        "metrics": [
          "accuracy"
        ],
        "type": "discriminative",
        "input_col": "sentence",
        "target_col": "label"
      }
    }
  },
  "method": {
    "name": "bitfit",
    "freeze": {
      "weights": true
    },
    "tune": {
      "biases": true
    }
  },
  "experiment": {
    "model": "gpt2_small",
    "domain": "news",
    "method": "bitfit"
  }
}