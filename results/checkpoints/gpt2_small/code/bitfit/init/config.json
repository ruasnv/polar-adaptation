{
  "training": {
    "optimizer": "adamw",
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "micro_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "max_seq_len": 512,
    "epochs": 5,
    "warmup_ratio": 0.06,
    "lr_schedule": "linear_decay",
    "gradient_clip": 1.0,
    "gradient_checkpointing": false,
    "bf16": true,
    "eval_every_n_steps": 500,
    "save_every_epoch": true,
    "seed": 42
  },
  "logging": {
    "log_every_n_steps": 10,
    "rotation_drift_every_n_steps": 100,
    "eigenvalue_variance_every_n_steps": 100,
    "effective_rank_every_n_steps": 100,
    "geometric_health_every_epoch": true
  },
  "geometric_health": {
    "stable_rank": true,
    "sv_entropy": true,
    "effective_rank": true,
    "condition_number": true,
    "nuclear_norm": true,
    "isotropy": true,
    "target_matrices": [
      "W_V",
      "W_O"
    ],
    "include_W_Q_W_K": false,
    "per_head": true,
    "aggregate_across_layers": true
  },
  "model": {
    "name": "gpt2",
    "hf_name": "gpt2",
    "params": "117M",
    "n_layers": 12,
    "n_heads": 12,
    "d_model": 768,
    "d_head": 64,
    "vocab_size": 50257
  },
  "domain": {
    "name": "code",
    "shift": "extreme",
    "tasks": {
      "code_completion": {
        "dataset": "code_search_net",
        "dataset_config": "python",
        "split_train": "train",
        "split_val": "validation",
        "split_test": "test",
        "metrics": [
          "pass_at_1",
          "bleu"
        ],
        "type": "generative",
        "input_col": "func_code_tokens",
        "target_col": "func_code_tokens"
      },
      "docstring_classification": {
        "dataset": "code_search_net",
        "dataset_config": "python",
        "split_train": "train",
        "split_val": "validation",
        "split_test": "test",
        "metrics": [
          "accuracy"
        ],
        "type": "discriminative",
        "input_col": "func_documentation_tokens",
        "target_col": "language"
      }
    }
  },
  "method": {
    "name": "bitfit",
    "freeze": {
      "weights": true
    },
    "tune": {
      "biases": true
    }
  },
  "experiment": {
    "model": "gpt2_small",
    "domain": "code",
    "method": "bitfit"
  }
}